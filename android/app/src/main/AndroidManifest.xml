<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Reading the adapter's on/off state needs BLUETOOTH up to API 30; from API 31 the
         state is readable without it. The permission implies a hardware requirement, so
         the uses-feature line is mandatory — without it Play hides the app from devices
         with no Bluetooth radio. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- Only used for the optional battery reminders; requested at runtime on Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The battery guard. ACTION_BATTERY_CHANGED is the only signal that reports every
         single point of level change, and the platform refuses to deliver it to a
         manifest-declared receiver — it must go to a running process. A foreground
         service is that process, and it is the only way an unprivileged app can alert at
         exactly 20% and exactly 80% rather than "somewhere past" them. It runs only while
         the user has armed a reminder, does no polling, and holds no wake lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Brings the guard back after a reboot; WorkManager restores its own jobs but a
         foreground service is not WorkManager's to restore. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Granted by the user via Settings > Usage access, not at runtime. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lets the battery's own manufacture date be read instead of asking the user for it.
         Ordinary installs never get this (signature|privileged|development), and the app
         falls back to a user-supplied date — but because the level includes "development"
         it can be granted once over ADB with no root:
           adb shell pm grant io.github.jenil1320.cellspan android.permission.BATTERY_STATS
         Every read is wrapped, so a denial is simply a missing date, never a crash. -->
    <uses-permission android:name="android.permission.BATTERY_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets Cellspan switch the phone's OWN charge limit on, which on a Pixel is
         Settings > Battery > Battery health > Charging optimization > "Limit to 80%".
         That is a real hardware charge stop; no app-level trick can do the same.

         Like BATTERY_STATS above, the protection level is
         signature|privileged|**development**, so an ordinary install never has it and the
         app falls back to a reminder — but the "development" flag means it CAN be granted
         once over ADB with no root, and the grant survives reboots:
           adb shell pm grant io.github.jenil1320.cellspan android.permission.WRITE_SECURE_SETTINGS
         Reading the setting needs no permission, so the UI can always show the true state
         and never claims a cap that is not there. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- See launchable apps so their names resolve (avoids QUERY_ALL_PACKAGES). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Home-screen apps declare HOME, not LAUNCHER, so they need their own entry. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- Battery history describes one specific cell, so it must not follow the user
         to another phone via cloud backup or device-to-device transfer. -->
    <application
        android:name=".CellspanApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cellspan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Cellspan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Captures charge-session endpoints even when the app isn't running. -->
        <receiver
            android:name=".data.PowerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Restarts the guard after a reboot or an app update. -->
        <receiver
            android:name=".data.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Watches the battery so the reminders land on the exact level the user chose. -->
        <service
            android:name=".data.BatteryGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuously monitors the battery level so the user's own charge and discharge reminders fire at the exact percentage they set. No other foreground service type covers battery-level monitoring, and the underlying ACTION_BATTERY_CHANGED broadcast is only delivered to a running process." />
        </service>
    </application>

</manifest>
