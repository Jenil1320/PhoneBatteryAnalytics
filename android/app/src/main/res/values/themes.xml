<resources>
    <style name="Theme.Cellspan" parent="android:Theme.Material.NoActionBar">
        <!-- The UI is light, so the launch window and status bar must be light too:
             below API 35 the status-bar icons are dark and vanish on a near-black bar. -->
        <item name="android:windowBackground">@color/windowBg</item>
        <item name="android:statusBarColor">@color/windowBg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
