<?xml version="1.0" encoding="utf-8"?>
<!--
  Cellspan launcher foreground: a battery with an ECG heartbeat line through it —
  "battery health". A light sage-white battery body reads boldly on the dark-green
  adaptive background; the pulse is drawn in the palette's pink accent. Content
  stays inside the ~72dp adaptive-icon safe zone; the flat ECG leads bleed to the
  edges on purpose so the pulse spans the icon on square/rounded masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Battery body (horizontal, rounded) -->
    <path
        android:fillColor="#FFEDF1EA"
        android:pathData="M35,42 H73 A5,5 0 0 1 78,47 V61 A5,5 0 0 1 73,66 H35 A5,5 0 0 1 30,61 V47 A5,5 0 0 1 35,42 Z" />
    <!-- Positive terminal -->
    <path
        android:fillColor="#FFEDF1EA"
        android:pathData="M78,50 H80 A2,2 0 0 1 82,52 V56 A2,2 0 0 1 80,58 H78 Z" />
    <!-- Heartbeat / ECG pulse -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFF06C9B"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M16,54 H48 L52,54 L54,58 L58,44 L61,64 L64,52 L67,54 H92" />
</vector>
