<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons. Only alpha matters — the system
  tints it. Line-art battery outline + heartbeat, so it stays legible when a
  launcher recolours it to a single tone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Battery outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round"
        android:pathData="M35,42 H73 A5,5 0 0 1 78,47 V61 A5,5 0 0 1 73,66 H35 A5,5 0 0 1 30,61 V47 A5,5 0 0 1 35,42 Z" />
    <!-- Positive terminal -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M80,49 H82 A2,2 0 0 1 84,51 V57 A2,2 0 0 1 82,59 H80 Z" />
    <!-- Heartbeat / ECG pulse -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M20,54 H48 L52,54 L54,58 L58,44 L61,64 L64,52 L67,54 H88" />
</vector>
